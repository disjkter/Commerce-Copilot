APP_NAME=Commerce Copilot
APP_HOST=127.0.0.1
APP_PORT=8010
DATABASE_PATH=runtime/commerce.db
# PostgreSQL runtime example:
# DATABASE_URL=postgresql+psycopg://commerce_copilot:password@127.0.0.1:5432/commerce_copilot
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_PROVIDER=openai_compatible
# Leave empty to reuse LLM_MODEL, or assign different models by task.
PLANNER_MODEL=
COMPOSER_MODEL=
LLM_STRUCTURED_OUTPUT=true
AUTH_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=120
LOGISTICS_WEBHOOK_SECRET=replace-with-a-separate-random-webhook-secret

# Single-process sliding-window rate limits. Keep proxy headers disabled unless
# the app is behind a trusted reverse proxy that overwrites X-Forwarded-For.
RATE_LIMIT_ENABLED=true
TRUST_PROXY_HEADERS=false
LOGIN_RATE_LIMIT=20
LOGIN_RATE_WINDOW_SECONDS=60
REGISTER_RATE_LIMIT=10
REGISTER_RATE_WINDOW_SECONDS=300
TURN_RATE_LIMIT=60
TURN_RATE_WINDOW_SECONDS=60
WEBHOOK_RATE_LIMIT=300
WEBHOOK_RATE_WINDOW_SECONDS=60

# Conversation memory keeps a short raw window and deterministically compacts
# older turns into structured entities, constraints and selected evidence.
CONTEXT_COMPACTION_ENABLED=true
CONTEXT_RECENT_TURNS=4

# Structured application logs: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Embeddings: keep feature_hash for the zero-download fallback, or use bge.
EMBEDDING_PROVIDER=feature_hash
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_PATH=
EMBEDDING_DEVICE=cpu
# adaptive: lexical first and invoke BGE only on lexical miss; hybrid: always fuse both.
RETRIEVAL_STRATEGY=adaptive
# Keep large Hugging Face model files off the C drive on Windows.
HF_HOME=E:/ProgramFiles/ModelCache/huggingface
