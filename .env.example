APP_NAME=Commerce Copilot
APP_HOST=127.0.0.1
APP_PORT=8010
DATABASE_PATH=runtime/commerce.db
# PostgreSQL runtime example:
# DATABASE_URL=postgresql+psycopg://commerce_copilot:password@127.0.0.1:5432/commerce_copilot
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
AUTH_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=120

# Structured application logs: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Embeddings: keep feature_hash for the zero-download fallback, or use bge.
EMBEDDING_PROVIDER=feature_hash
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_PATH=
EMBEDDING_DEVICE=cpu
# adaptive: lexical first and invoke BGE only on lexical miss; hybrid: always fuse both.
RETRIEVAL_STRATEGY=adaptive
# Keep large Hugging Face model files off the C drive on Windows.
HF_HOME=E:/ProgramFiles/ModelCache/huggingface
