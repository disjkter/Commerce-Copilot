APP_NAME=Commerce Copilot
LOG_LEVEL=INFO

POSTGRES_DB=commerce_copilot
POSTGRES_USER=commerce_app
POSTGRES_PASSWORD=replace-with-a-long-random-password

LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
PLANNER_MODEL=deepseek-chat
COMPOSER_MODEL=deepseek-chat
LLM_API_KEY=replace-with-your-api-key
LLM_STRUCTURED_OUTPUT=true

AUTH_SECRET=replace-with-at-least-32-random-bytes
LOGISTICS_WEBHOOK_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_MINUTES=120

EMBEDDING_PROVIDER=feature_hash
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
RETRIEVAL_STRATEGY=adaptive

RATE_LIMIT_ENABLED=true
# Safe here because Compose binds the API to 127.0.0.1 behind the local Nginx proxy.
TRUST_PROXY_HEADERS=true
CONTEXT_COMPACTION_ENABLED=true
CONTEXT_RECENT_TURNS=4
